# ---------------------------------------------------------------
# Core stack — single source of configuration
# Copy to .env (setup.sh does this for you). .env is not committed:
# it holds your Cloudflare and Tailscale secrets.
# ---------------------------------------------------------------

# Compose project name (prefix for containers/networks)
COMPOSE_PROJECT_NAME=core-stack

# Optional services to run, comma-separated:
#   tunnel     = cloudflared (needs CLOUDFLARE_TUNNEL_TOKEN)
#   tailscale  = Tailscale   (needs TS_AUTHKEY on first start)
# Leave empty to run only AdGuard Home and Homepage.
COMPOSE_PROFILES=tunnel,tailscale

# User/group for containers that support it (run `id -u` / `id -g`)
PUID=1000
PGID=1000

# Timezone (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=Europe/Amsterdam

# Where each app stores its config/state
CONFIG_ROOT=./config

# ---------------------------------------------------------------
# Server and home network
# ---------------------------------------------------------------
# LAN IP of this server (setup.sh can detect it)
SERVER_IP=192.168.1.10
# Local name for the server, set up as a DNS rewrite in AdGuard Home
SERVER_NAME=server.home
# Your home network, shared with Tailscale devices (setup.sh can detect it)
LAN_SUBNET=192.168.1.0/24

# ---------------------------------------------------------------
# Image tags
# ---------------------------------------------------------------
CLOUDFLARED_TAG=latest
TAILSCALE_TAG=latest
ADGUARD_TAG=latest
HOMEPAGE_TAG=latest
SOCKET_PROXY_TAG=latest

# ---------------------------------------------------------------
# Host ports
# ---------------------------------------------------------------
# Homepage on port 80, so the family can just type http://server.home
HOMEPAGE_PORT=80
# AdGuard Home admin interface. Enter this same port as the "Admin Web
# Interface" port in the first-run wizard. To change it later, also change
# http.address in config/adguardhome/conf/AdGuardHome.yaml.
ADGUARD_WEB_PORT=8053
# AdGuard Home first-run wizard (only used once)
ADGUARD_SETUP_PORT=3000
# IP the DNS server (port 53) listens on. 0.0.0.0 = all interfaces.
# Set to SERVER_IP if something else needs port 53 on another interface.
DNS_BIND_IP=0.0.0.0

# ---------------------------------------------------------------
# Cloudflare Tunnel (profile: tunnel)
# ---------------------------------------------------------------
# Zero Trust dashboard -> Networks -> Tunnels -> your tunnel -> token
CLOUDFLARE_TUNNEL_TOKEN=

# ---------------------------------------------------------------
# Tailscale (profile: tailscale)
# ---------------------------------------------------------------
# Admin console -> Settings -> Keys -> Generate auth key.
# Only needed for the first login; the state is kept in CONFIG_ROOT.
TS_AUTHKEY=
# Name of this server in your tailnet
TS_HOSTNAME=home-server
# Extra flags, e.g. --advertise-exit-node to route all traffic via home
TS_EXTRA_ARGS=

# ---------------------------------------------------------------
# Backups (backup.sh)
# ---------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_KEEP=7
